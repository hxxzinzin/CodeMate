# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 Git에 커밋되지 않습니다)

# Gemini — 서버 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
GEMINI_API_KEY=
GEMINI_MODEL=

# Supabase — 브라우저에 노출되어도 되는 값 (RLS로 보호)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — 서버 전용. 힌트/해설 조회에만 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=
