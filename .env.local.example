# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 Git에 커밋되지 않습니다)

# Gemini — 서버 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
# 키 발급: https://aistudio.google.com/apikey  /  연결 확인: npm run ai:smoke
GEMINI_API_KEY=
# 비워 두면 기본값 사용 (모델 선택 근거: docs/decisions.md ADR-010)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Supabase — 브라우저에 노출되어도 되는 값 (데이터는 RLS로 보호)
# 클라우드: Dashboard → Project Settings → API Keys 의 Publishable key
# 로컬: `npm run db:start` 출력의 API_URL, PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — 서버 전용(RLS 우회). 힌트/해설 조회, AI 기록 저장에만 사용합니다.
# 클라우드: 같은 화면의 Secret key / 로컬: `npm run db:start` 출력의 SECRET_KEY
SUPABASE_SECRET_KEY=

# 자동 채점 (OnlineCompiler.io) — 서버 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
# 비워 두면 자동 채점이 꺼지고, 사용자가 예제로 직접 확인한 결과로 제출합니다. (ADR-003, ADR-014)
# 키 발급: https://onlinecompiler.io (무료 플랜, 카드 등록 없음)  /  연결 확인: npm run judge:smoke
ONLINECOMPILER_API_KEY=
